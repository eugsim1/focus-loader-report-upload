# Copy to /etc/focus-loader/focus-loader.env and chmod 600.
# Do not commit the populated file.

APP_DIR=/opt/focus-loader
DATA_DIR=/var/lib/focus-loader
LOG_DIR=/var/log/focus-loader
LOCK_FILE=/var/lib/focus-loader/focus-loader.lock

# upload-only | load | upload-and-load | preload-report
MODE=upload-only
WORKERS=4
MINIMUM_FILE_DATE=2026-01-01

# OCI authentication: instance_principal or config_file
OCI_AUTH_MODE=instance_principal
OCI_CONFIG_FILE=/home/opc/.oci/config
OCI_PROFILE=DEFAULT
SOURCE_NAMESPACE=bling
SOURCE_BUCKET=

# Database connectivity is currently required in every mode, including upload-only.
DB_USER=FOCUS_APP
DB_CONNECT=focusdb_high
TNS_ADMIN=/opt/oracle/wallet

# Recommended for cron: OCI Vault secret OCID. With config-file auth, set
# DB_SECRET_PROFILE to the profile that can read the secret. With instance
# principals, leave DB_SECRET_PROFILE empty.
DB_SECRET_ID=ocid1.vaultsecret.oc1..replace_me
DB_SECRET_PROFILE=

# Optional fallback. Avoid plaintext passwords when possible. If set, the
# wrapper reads the first line and passes it with -dp; command-line exposure
# may be possible to same-host users.
DB_PASSWORD_FILE=

# Required for upload-only and upload-and-load.
DESTINATION_NAMESPACE=
DESTINATION_BUCKET=replace_me
DESTINATION_REGION=
DESTINATION_PREFIX=transformed-focus

# Persistent checkpoints. Never place these under /tmp.
LOAD_STATE_FILE=/var/lib/focus-loader/processed_files.jsonl
UPLOAD_STATE_FILE=/var/lib/focus-loader/uploaded_files.jsonl
LATEST_UPLOAD_FILE=/var/lib/focus-loader/latest_focus_file_upload.csv
UPLOAD_RESULTS_FILE=/var/lib/focus-loader/focus_file_upload_results.csv

# Oracle Instant Client. Adjust to the installed version.
ORACLE_CLIENT_LIB=/usr/lib/oracle/23/client64/lib
ORACLE_CLIENT_BIN=/usr/lib/oracle/23/client64/bin

# Optional flags: true or false
KEEP_WORK_FILES=false
SKIP_TAGS=false
VERBOSE=false
