# Copy to /etc/focus-loader/streamlit.env and chmod 0640.
FOCUS_API_URL=http://127.0.0.1:8080
FOCUS_API_URL_FOCUSLOADER=http://127.0.0.1:8080
FOCUS_API_URL_ORACLE=http://127.0.0.1:8081
FOCUS_LOADER_EXECUTABLE=/opt/focus-loader/focus-loader-report-upload
FOCUS_LOADER_EXECUTABLE_FOCUSLOADER=/opt/focus-loader/focus-loader-report-upload
FOCUS_LOADER_EXECUTABLE_ORACLE=/home/oracle/focus-loader-report-upload/dist/focus-loader-report-upload-linux-amd64
