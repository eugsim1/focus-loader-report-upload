[Unit]
Description=FOCUS Loader TNS alias and database metadata API
After=network.target

[Service]
Type=simple
User=focusloader
Group=focusloader
WorkingDirectory=/opt/focus-loader
EnvironmentFile=/etc/focus-loader/tns-gui.env
ExecStart=/opt/focus-loader/focus-loader-report-upload -tns-gui -tns-gui-listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
