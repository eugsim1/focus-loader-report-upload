[Unit]
Description=FOCUS Loader TNS, database metadata, schema deployment, and execution API
After=network.target

[Service]
Type=simple
User=focusloader
Group=focusloader
WorkingDirectory=/opt/focus-loader
EnvironmentFile=/etc/focus-loader/tns-gui.env
ExecStart=/opt/focus-loader/focus-loader-report-upload -tns-gui -tns-gui-listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/opt/focus-loader/focus.conf /opt/focus-loader/sql_scripts/focus.conf /opt/focus-loader/work_report_dir

[Install]
WantedBy=multi-user.target
