# Copy to /etc/focus-loader/tns-gui.env, set the real directory, and chmod 0640.
# TNS_ADMIN must name a directory containing tnsnames.ora, not the file itself.
TNS_ADMIN=/opt/oracle/wallet
FOCUS_SQL_SCRIPTS_DIR=/opt/focus-loader/sql_scripts
# Include the directory containing sqlplus before the standard system paths.
PATH=/usr/lib/oracle/23/client64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
