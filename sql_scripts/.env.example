# Copy to .env, set real values locally, and never commit .env.
TNS_ADMIN=/path/to/extracted/wallet
DB_ADMIN_USER=ADMIN
DB_ADMIN_PASSWORD=replace-me
DB_TNS_ALIAS=database_high
TARGET_SCHEMA=FOCUS_APP
TARGET_SCHEMA_PASSWORD=replace-me
FOCUS_CONFIG_FILE=focus.conf
DROP_EXISTING=false

# Optional OCI Vault report settings.
OCI_CLI_PROFILE=DEFAULT
DATABASE_USER=FOCUS_APP
DATABASE_NAME=database_high
DATABASE_SECRET_ID=ocid1.vaultsecret.oc1.region.example
OUTPUT_FILE=focus_tag_keys.csv

